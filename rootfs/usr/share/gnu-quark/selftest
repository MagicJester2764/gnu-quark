#!/usr/bin/bash
# GNU/Quark checking itself: bash, and the coreutils it runs, each doing a
# small thing whose answer is known.
#
#     bash /usr/share/gnu-quark/selftest
#
# Every check is a command and what it should print. One that prints something
# else says so. The last line is the count, and the exit status is whether
# anything failed.

pass=0
fail=0

# is NAME "what it printed" "what it should have"
is() {
    if [ "$2" = "$3" ]; then
        pass=$((pass + 1))
    else
        fail=$((fail + 1))
        printf 'FAIL  %s\n      got:    %s\n      wanted: %s\n' "$1" "$2" "$3"
    fi
}

T=$(mktemp -d /tmp/selftest.XXXXXX) || { echo "selftest: no temporary directory"; exit 1; }
cd "$T" || exit 1

# --- text -------------------------------------------------------------------
printf 'b\na\nc\n' > f
is "sort"          "$(sort f | tr '\n' ' ')"                    "a b c "
is "sort -r"       "$(sort -r f | tr '\n' ' ')"                 "c b a "
is "sort -n"       "$(printf '10\n9\n100\n' | sort -n | tr '\n' ' ')" "9 10 100 "
is "wc -l"         "$(wc -l < f)"                               "3"
is "wc -c"         "$(wc -c < f)"                               "6"
is "head"          "$(head -1 f)"                               "b"
is "tail"          "$(tail -1 f)"                               "c"
is "tac"           "$(tac f | tr '\n' ' ')"                     "c a b "
is "cut"           "$(echo a:b:c | cut -d: -f2)"                "b"
is "tr"            "$(echo abc | tr a-c A-C)"                   "ABC"
is "uniq -c"       "$(printf 'a\na\nb\n' | uniq -c | tr -s ' ' | tr '\n' ';')" " 2 a; 1 b;"
is "nl"            "$(printf 'x\n' | nl | tr -s ' \t' ' ')"     " 1 x"
is "fold"          "$(echo abcdef | fold -w3 | tr '\n' ' ')"    "abc def "
is "paste"         "$(printf '1\n2\n' | paste -sd+)"            "1+2"
is "join"          "$(join <(printf 'a 1\nb 2\n') <(printf 'a x\nb y\n') | tr '\n' ';')" "a 1 x;b 2 y;"
is "comm"          "$(comm -12 <(printf 'a\nb\n') <(printf 'b\nc\n'))" "b"
is "expand"        "$(printf 'a\tb\n' | expand -t4)"            "a   b"
is "seq"           "$(seq -s, 1 5)"                             "1,2,3,4,5"
is "shuf"          "$(seq 1 20 | shuf | sort -n | tr '\n' ' ')" "$(seq 1 20 | tr '\n' ' ')"
is "tee"           "$(echo t | tee g; cat g)"                   "t
t"
is "split"         "$(seq 1 10 | split -l 4 - part.; ls part.* | wc -l)" "3"
is "csplit"        "$(printf '1\n2\n3\n4\n' | csplit -s - 3; cat xx01 | tr '\n' ' ')" "3 4 "
is "od"            "$(printf 'AB' | od -An -tx1 | tr -d ' ')"   "4142"
is "base64"        "$(printf hello | base64)"                   "aGVsbG8="
is "base64 -d"     "$(echo aGVsbG8= | base64 -d)"               "hello"
is "md5sum"        "$(printf abc | md5sum | cut -d' ' -f1)"     "900150983cd24fb0d6963f7d28e17f72"
is "sha256sum"     "$(printf abc | sha256sum | cut -d' ' -f1)"  "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
is "cksum"         "$(printf abc | cksum)"                      "1219131554 3"
is "numfmt"        "$(numfmt --to=iec 1048576)"                 "1.0M"

# --- numbers and names --------------------------------------------------------
is "expr"          "$(expr 6 \* 7)"                             "42"
is "factor"        "$(factor 60)"                               "60: 2 2 3 5"
is "printf"        "$(printf '%05.1f|%x|%s' 3.14159 255 q)"     "003.1|ff|q"
is "basename"      "$(basename /usr/bin/ls)"                    "ls"
is "dirname"       "$(dirname /usr/bin/ls)"                     "/usr/bin"
is "test"          "$(test 3 -lt 5 && [ -d /usr ] && echo yes)" "yes"
is "true, false"   "$(true; a=$?; false; echo $a $?)"           "0 1"
is "date"          "$(date -u -d @86400 +%Y-%m-%d)"             "1970-01-02"
is "uname"         "$(uname -s)"                                "Quark"
is "id"            "$(id -un):$(id -u):$(id -gn)"               "root:0:root"
is "whoami"        "$(whoami)"                                  "root"
is "env"           "$(env -i X=1 /usr/bin/printenv X)"          "1"
# How many processors is the machine's business. That it is a number, and
# that every one of them is this program's to run on, is the system's.
is "nproc"         "$(nproc | grep -c '^[1-9][0-9]*$')"         "1"
is "nproc --all"   "$(nproc --all)"                             "$(nproc)"
is "df"            "$(df -P / | tail -1 | tr -s ' ' | cut -d' ' -f6)" "/"

# --- characters that are more than a byte ----------------------------------------
cafe=$(printf 'caf\303\251')
is "wc -m"         "$(printf '%s' "$cafe" | wc -m)"             "4"
is "wc -c"         "$(printf '%s' "$cafe" | wc -c)"             "5"
is "ls, a name"    "$(mkdir u && touch "u/$cafe" && ls u)"      "$cafe"
is "\${#var}"       "${#cafe}"                                   "4"
is "tr, upper"     "$(echo "$cafe" | cut -c1-3)"                "caf"
is "expr length"   "$(expr length "$cafe")"                     "4"

# --- time, and children ---------------------------------------------------------
is "timeout"       "$(timeout 1 sleep 5; echo $?)"              "124"
is "timeout, met"  "$(timeout 5 echo done; echo $?)"            "done
0"
is "read -t"       "$(read -t 1 x < <(sleep 2); echo $?)"       "142"
is "sleep, timed"  "$(a=$(date +%s); sleep 2; echo $(( $(date +%s) - a >= 2 )))" "1"

# --- files ----------------------------------------------------------------------
mkdir -p d/e/f
is "mkdir -p"      "$(test -d d/e/f && echo yes)"               "yes"
echo data > d/e/f/x
cp -r d d2
is "cp -r"         "$(cat d2/e/f/x)"                            "data"
mv d2 d3
is "mv"            "$(test -d d3 && test ! -e d2 && echo yes)"  "yes"
ln -s f link
is "ln -s"         "$(readlink link)"                           "f"
is "realpath"      "$(realpath link)"                           "$T/f"
ln f hard
is "ln"            "$(stat -c %h f)"                            "2"
chmod 640 f
is "chmod"         "$(stat -c %a f)"                            "640"
is "stat"          "$(stat -c '%s %F' f)"                       "6 regular file"
truncate -s 100 t
is "truncate"      "$(stat -c %s t)"                            "100"
dd if=/dev/zero of=z bs=1k count=4 2> /dev/null
is "dd"            "$(stat -c %s z)"                            "4096"
is "du"            "$(du -sk z | cut -f1)"                      "4"
touch -d '2020-01-02 03:04:05' ts
is "touch -d"      "$(date -r ts +%Y%m%d%H%M%S)"                "20200102030405"
cp -p ts ts2
is "cp -p"         "$(date -r ts2 +%Y%m%d%H%M%S)"               "20200102030405"
install -m 755 f inst
is "install"       "$(stat -c %a inst)"                         "755"
is "ls"            "$(ls -1 d | tr '\n' ' ')"                   "e "
is "ls -d glob"    "$(ls -d part.* | wc -l)"                    "3"
rm -r d d3
is "rm -r"         "$(test ! -e d && test ! -e d3 && echo yes)" "yes"
rmdir "$(mktemp -d ./tmp.XXXXXX)" && is "mktemp, rmdir" "$(ls -d tmp.* 2> /dev/null | wc -l)" "0"
is "sync"          "$(sync && echo yes)"                        "yes"

# --- a pipe with a name -----------------------------------------------------------
mkfifo pipe
is "mkfifo"        "$(stat -c %F pipe)"                         "fifo"
is "test -p"       "$(test -p pipe && echo yes)"                "yes"
is "ls -l of one"  "$(ls -l pipe | cut -c1)"                    "p"
is "writer first"  "$(echo said > pipe & cat pipe; wait)"       "said"
is "reader first"  "$( (sleep 1; echo late > pipe) & read -r x < pipe; wait; echo "$x")" "late"
is "two lines"     "$(printf 'a\nb\n' > pipe & wc -l < pipe; wait)" "2"
mknod pipe2 p
is "mknod p"       "$(test -p pipe2 && echo yes)"               "yes"
rm pipe pipe2
is "rm of one"     "$(test ! -e pipe && echo yes)"              "yes"

# --- looking for things: grep, find -------------------------------------------------
is "grep -c"       "$(printf 'a\nb\nab\n' | grep -c a)"         "2"
is "grep -E"       "$(printf 'cat\ncot\ncut\n' | grep -E 'c[ao]t' | tr '\n' ' ')" "cat cot "
is "grep -v, -n"   "$(printf 'x\ny\nx\n' | grep -vn x)"          "2:y"
mkdir -p gr/sub && echo needle > gr/sub/hay && echo straw > gr/other
is "grep -r"       "$(grep -rl needle gr)"                      "gr/sub/hay"
is "grep, UTF-8"   "$(echo 'naïve café' | grep -o 'é')"         "é"
is "grep -i"       "$(echo Quark | grep -ic QUARK)"             "1"
is "egrep"         "$(echo abc | egrep -c 'b|x' 2> /dev/null)"  "1"
mkdir -p fd/a/b && touch fd/a/b/x.c fd/a/y.h
is "find -name"    "$(find fd -name '*.c')"                     "fd/a/b/x.c"
is "find -type d"  "$(find fd -type d | sort | tr '\n' ' ')"    "fd fd/a fd/a/b "
is "find -exec"    "$(find fd -name '*.h' -exec basename {} \;)" "y.h"
is "find -size"    "$(find fd -type f -size 0 | wc -l)"         "2"
is "find -maxdepth" "$(find fd -maxdepth 1 | wc -l)"            "2"
is "xargs"         "$(printf 'a\nb\nc\n' | xargs echo)"         "a b c"
is "find | xargs"  "$(find fd -type f -print0 | xargs -0 ls | wc -l)" "2"

# --- changing text: sed, awk ------------------------------------------------------
is "sed s///g"     "$(echo hello | sed 's/l/L/g')"              "heLLo"
is "sed -n p"      "$(printf '1\n2\n3\n' | sed -n '2p')"        "2"
is "sed -E"        "$(echo a1b22 | sed -E 's/[0-9]+/#/g')"      "a#b#"
is "sed -i"        "$(echo old > sf; sed -i 's/old/new/' sf; cat sf)" "new"
is "sed, a range"  "$(printf 'a\nb\nc\nd\n' | sed '2,3d' | tr '\n' ' ')" "a d "
is "awk, a field"  "$(echo 'a b c' | awk '{print $2}')"         "b"
is "awk, a sum"    "$(printf '1\n2\n3\n' | awk '{s += $1} END {print s}')" "6"
is "awk -F"        "$(awk -F: '$3 == 0 {print $1}' /etc/passwd)" "root"
is "awk, floating point" "$(awk 'BEGIN {printf "%.3f\n", 22/7}')" "3.143"
is "awk, an array" "$(printf 'x\ny\nx\n' | awk '{n[$1]++} END {print n["x"] n["y"]}')" "21"
is "awk, a function" "$(awk 'function sq(v) {return v*v} BEGIN {print sq(12), toupper("q"), length("café")}')" "144 Q 4"
is "gawk"          "$(gawk --version | head -1 | cut -d, -f1)"   "GNU Awk 5.4.1"

# --- comparing, and putting away: diff, tar, gzip ---------------------------------
echo a > d1; cp d1 d2
is "diff, the same" "$(diff d1 d2 && echo same)"                "same"
echo b > d2
is "diff -u"       "$(diff -u d1 d2 | grep -c '^[-+][ab]')"     "2"
is "diff -r"       "$(diff -rq gr fd > /dev/null; echo $?)"     "1"
is "cmp"           "$(cmp -s d1 d2; echo $?)"                   "1"
chmod 640 fd/a/y.h; touch -d '2021-03-04 05:06:07' fd/a/y.h
is "tar c, t"      "$(tar cf t.tar fd && tar tf t.tar | wc -l)" "5"
mkdir tx
is "tar x"         "$(tar xf t.tar -C tx && find tx -type f | wc -l)" "2"
is "tar keeps modes and times" "$(stat -c '%a %Y' tx/fd/a/y.h)" "640 $(date -d '2021-03-04 05:06:07' +%s)"
echo squeezed > gz
is "gzip, gunzip"  "$(gzip gz && gunzip -c gz.gz)"              "squeezed"
is "zcat"          "$(zcat gz.gz)"                              "squeezed"
is "gzip -l"       "$(gzip -l gz.gz | tail -1 | awk '{print $2}')" "9"
is "tar z"         "$(tar czf t.tgz fd && tar tzf t.tgz | wc -l)" "5"
is "tar z, out again" "$(mkdir tz && tar xzf t.tgz -C tz && diff -r fd tz/fd && echo same)" "same"
is "a big file, through gzip" "$(head -c 300000 /dev/zero | gzip | gunzip | wc -c)" "300000"

# --- make, in an image that asked for it ---------------------------------------------
if command -v make > /dev/null; then
    mkdir mk && printf 'all: out\nout: in\n\tcp in out\nclean:\n\trm -f out\n' > mk/Makefile
    echo made > mk/in
    is "make"          "$(make -s -C mk && cat mk/out)"             "made"
    is "make, done"    "$(make -q -C mk && echo nothing to do)"     "nothing to do"
    is "make, again"   "$(sleep 1; echo changed > mk/in; make -s -C mk && cat mk/out)" "changed"
    is "make -j"       "$(printf 'all: a b c\na b c:\n\t@echo $@ > $@\n' > mk/j.mk; make -s -j3 -C mk -f j.mk && cat mk/a mk/b mk/c | tr '\n' ' ')" "a b c "
    is "make clean"    "$(make -s -C mk clean && test ! -e mk/out && echo gone)" "gone"
fi

# --- the shell ------------------------------------------------------------------
is "arithmetic"    "$((2 ** 10 + 7 % 4))"                       "1027"
is "arrays"        "$(a=(x y z); echo ${#a[@]} ${a[1]})"        "3 y"
is "associative"   "$(declare -A m; m[k]=v; echo ${m[k]} ${!m[@]})" "v k"
is "substring"     "$(s=quark; echo ${s:1:3} ${s^^} ${#s})"     "uar QUARK 5"
is "pattern"       "$(p=/usr/bin/ls; echo ${p##*/} ${p%/*})"    "ls /usr/bin"
is "case"          "$(case abc in a*) echo match ;; *) echo no ;; esac)" "match"
is "while read"    "$(printf '1\n2\n' | while read n; do echo $((n * 2)); done | tr '\n' ' ')" "2 4 "
is "for, brace"    "$(for i in {1..3}; do printf $i; done)"     "123"
is "function"      "$(f() { return 5; }; f; echo $?)"           "5"
is "here string"   "$(cat <<< hi)"                              "hi"
is "here document" "$(cat << END
a $((1 + 1))
END
)"                                                              "a 2"
is "subshell"      "$( (exit 7); echo $?)"                      "7"
is "not found"     "$(no-such-command 2> /dev/null; echo $?)"   "127"
is "command -v"    "$(command -v ls)"                           "$(alias ls > /dev/null 2>&1 && echo "alias ls='ls --color=auto'" || echo /usr/bin/ls)"
is "exec in path"  "$(type -P sort)"                            "/usr/bin/sort"
is "redirect 2>&1" "$(ls /nonexistent 2>&1 | wc -l)"            "1"
is "append"        "$(echo 1 > ap; echo 2 >> ap; wc -l < ap)"   "2"
is "noclobber off" "$(echo a > nc; echo b > nc; cat nc)"        "b"
is "background"    "$( (sleep 1; exit 3) & wait $!; echo $?)"   "3"
is "kill"          "$(sleep 30 & kill $!; wait $!; echo $?)"    "143"
is "kill -9"       "$(sleep 30 & kill -9 $!; wait $!; echo $?)" "137"
is "stop, continue" "$(sleep 30 & p=$!; kill -STOP $p; sleep 1; kill -CONT $p; kill $p; wait $p; echo $?)" "143"
is "a stopped job" "$(bash -c 'set -m; sleep 30 & kill -STOP %1; sleep 1; jobs | tr -s " " | cut -d" " -f2; kill %1' 2> /dev/null)" "Stopped"
is "PIPESTATUS"    "$(false | true | (exit 3); echo ${PIPESTATUS[*]})" "1 0 3"
is "trap EXIT"     "$(bash -c 'trap "echo bye" EXIT')"          "bye"
is "trap signal"   "$(bash -c 'trap "echo caught" USR1; kill -USR1 $$; echo after')" "caught
after"
is "SIGPIPE"       "$(yes | head -1)"                           "y"
is "script file"   "$(printf '#!/usr/bin/bash\necho from a script $1\n' > s; chmod +x s; ./s arg)" "from a script arg"
is "sh"            "$(sh -c 'echo $0')"                         "sh"
is "exit status"   "$(bash -c 'exit 42'; echo $?)"              "42"
is "cd, pwd"       "$(cd /usr/bin && pwd)"                      "/usr/bin"
is "umask"         "$(umask 077; touch um; stat -c %a um)"      "600"
is "\$\$ is stable" "$(echo $$)"                                "$$"
is "pids differ"   "$(true & a=$!; wait; true & b=$!; wait; [ $a != $b ] && echo yes)" "yes"
is "after a job"   "$(sleep 1 & wait; a=$(date +%s); sleep 2; echo $(( $(date +%s) - a >= 2 )))" "1"

cd /
rm -rf "$T"
echo "selftest: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
