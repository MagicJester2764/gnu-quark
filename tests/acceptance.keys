# The acceptance test: what GNU/Quark is for, typed at it.
#
# Each line is an operation (tools/drive-qemu.py has the list). `expect` waits
# for the prompt, `saw` says what the command must have printed.

# It boots to a login prompt, and the login is on a terminal.
expect 120 ^login:$
type root\n
expect 30 ^root@quark:~#$

# GNU ls: modes, owners, dates, and where a link goes. The colours are in the
# screenshot.
type ls -l --color /\n
expect 30 #$
saw ^lrwxrwxrwx +1 root root +7 .* bin -> usr/bin$
saw ^drwx------ +\d+ root root +\d+ .* root$
saw ^drwxrwxrwt +\d+ root root +\d+ .* tmp$
shot build/acceptance-ls.ppm

# cp -a keeps what it copies: the modes, and the times.
type cp -a /etc /tmp/etc2 && ls -l /tmp/etc2\n
expect 60 #$
saw ^-rw-r--r-- +1 root root +\d+ .* passwd$
type test /etc/passwd -ot /tmp/etc2/passwd || test /etc/passwd -nt /tmp/etc2/passwd || echo same age\n
expect 30 #$
saw ^same age$

type du -sh /usr\n
expect 120 #$
saw ^\d+M\s+/usr$

# A pipeline, both ends of it GNU's.
type sort /etc/passwd /etc/passwd | uniq -c\n
expect 30 #$
saw ^ +2 root:x:0:0:root:/root:/usr/bin/bash$

# Redirection, both ways.
type echo redirected > /tmp/f; cat < /tmp/f\n
expect 30 #$
saw ^redirected$

# A pipe with a name: two commands that meet at a place in the filesystem.
type mkfifo /tmp/p; ls -l /tmp/p | cut -c1; (echo met by name > /tmp/p &); cat /tmp/p; rm /tmp/p\n
expect 30 #$
saw ^p$
saw ^met by name$

# The rest of what a GNU system has before anything is installed: finding
# things, changing text, comparing, putting away.
type echo "$(grep -c bash /etc/passwd) shell, $(find /usr/bin -name 'g*' | wc -l) programs beginning with g"\n
expect 30 #$
saw ^1 shell, \d+ programs beginning with g$
type awk -F: '{ print $1 " logs in to " $7 }' /etc/passwd | sed 's/usr.bin.//'\n
expect 30 #$
saw ^root logs in to /bash$
type tar czf /tmp/etc.tgz -C / etc && tar tzf /tmp/etc.tgz | grep -c . | sed 's/$/ names put away/'\n
expect 60 #$
saw ^\d+ names put away$
type diff <(ls /bin) <(ls /usr/bin) && echo the same programs by either name\n
expect 30 #$
saw ^the same programs by either name$

# The shell moves, and what it starts starts where it is: the two
# directories of programs, found from inside /usr by a pattern.
type cd /usr && pwd && ls -d *bin | wc -l\n
expect 30 ^root@quark:/usr#$
saw ^/usr$
saw ^2$

# A loop, redirected as a whole.
type for i in 1 2 3; do echo line $i; done > /tmp/g; wc -l < /tmp/g; tail -1 /tmp/g\n
expect 30 #$
saw ^3$
saw ^line 3$

# Whose programs these are.
type cd; type cp cd; ls --version | head -1; bash --version | head -1\n
expect 30 ^root@quark:~#$
saw ^cp is (hashed \()?/usr/bin/cp\)?$
saw ^cd is a shell builtin$
saw ^ls \(GNU coreutils\) 9\.11$
saw ^GNU bash, version 5\.3

# Ctrl-C ends what is running, and the shell says how it ended.
type sleep 100\n
sleep 2
key ctrl+c
expect 20 #$
type echo interrupted $?\n
expect 20 #$
saw ^interrupted 130$

# Ctrl-Z stops what is running and gives the prompt back, and the shell
# knows what it has: a job.
type sleep 100\n
sleep 2
key ctrl+z
expect 20 #$
saw ^\[1\]\+  Stopped +sleep 100$
type ps\n
expect 20 #$
saw ^ +\d+ +\d+ +\d+ +STOP +0 +-?\d+ +\d+:\d\d\.\d\d$

# Behind, it runs. In front again, Ctrl-C is for it and not for the shell.
type bg; sleep 1; jobs\n
expect 20 #$
saw ^\[1\]\+  Running +sleep 100 &$
type fg\n
sleep 2
key ctrl+c
expect 20 #$
type echo ended $? with $(jobs | wc -l) left\n
expect 20 #$
saw ^ended 130 with 0 left$

# A job that reads the terminal from behind is stopped until it is brought
# forward: what is typed is for whoever is in front.
type cat &\n
expect 20 #$
type jobs\n
expect 20 #$
saw ^\[1\]\+  Stopped +cat$
type fg\n
sleep 1
type what cat was given\n
sleep 1
key ctrl+d
expect 20 #$
saw ^what cat was given$

# A command run after a background job is still waited for: each number below
# is printed by a program started after the last one ended.
type sleep 1 & wait; date +%s > /tmp/t1; sleep 2; date +%s > /tmp/t2; echo took $(( $(cat /tmp/t2) - $(cat /tmp/t1) ))\n
expect 30 #$
saw ^took [23]$

# A pipe whose reader has had enough ends its writer.
type yes | head -2 | wc -l\n
expect 30 #$

# The console is UTF-8: an accent, curly quotes, Greek, and a character two
# cells wide, each drawn as itself in the font the console was given at boot.
# (A backslash is doubled here because this file's own escapes come first.)
type printf 'caf\\xc3\\xa9 \\xe2\\x80\\x98q\\xe2\\x80\\x99 \\xce\\xbb \\xe4\\xb8\\xad'; echo\n
expect 30 #$
saw ^café ‘q’ λ 中$

# The session is on a terminal, and the terminal has a name.
type tty\n
expect 30 #$
saw ^/dev/pts/0$

# A command given a second is ended after one, and the shell is told so.
type timeout 1 sleep 5; echo "timed out $?"\n
expect 30 #$
saw ^timed out 124$

# And the rest, by the system itself: ninety-odd small things with known
# answers, each done by bash or by one of the coreutils.
# Every processor the machine has is one GNU's programs can count: from the
# firmware's tables, through the kernel and the C library, to coreutils.
type echo "$(nproc) of @SMP@ processors"\n
expect 30 #$
saw ^@SMP@ of @SMP@ processors$

type bash /usr/share/gnu-quark/selftest\n
expect 300 #$
saw ^selftest: \d+ passed, 0 failed$

# More than one user. Root makes one with Unix's commands, which write
# Unix's files, puts it in a group, and gives it and root passwords.
type useradd -m -c Ada ada && groupadd staff && gpasswd -a ada staff\n
expect 30 #$
# And a second, whose files are to be the second's and not the first's.
type useradd -m bob && echo for bob alone > /home/bob/notes && chown bob:bob /home/bob/notes\n
expect 30 #$
type passwd ada\n
expect 30 ^New password:$
type what ada types\n
expect 30 ^Again:$
type what ada types\n
expect 30 #$
saw ^passwd: changed$
type passwd\n
expect 30 ^New password:$
type what root types\n
expect 30 ^Again:$
type what root types\n
expect 30 #$
type echo "$(grep -c '^ada:x:1000:1000:Ada:/home/ada:/usr/bin/bash$' /etc/passwd) account, $(grep -c '^ada:[$]6[$]' /etc/shadow) hashed password"\n
expect 30 #$
saw ^1 account, 1 hashed password$
type ls -ld /home/ada /etc/shadow\n
expect 30 #$
saw ^drwx------ +\d+ ada +ada +\d+ .* /home/ada$
saw ^-rw------- +1 root root +\d+ .* /etc/shadow$

# What is root's is root's. A user reads neither root's files nor the
# passwords, and is in the groups it was put in: a file of one of them opens.
type echo for root alone > /root/secret; echo for the staff > /tmp/staff; chgrp staff /tmp/staff; chmod 640 /tmp/staff\n
expect 30 #$
type su ada -c 'id; cat /root/secret /etc/shadow; cat /tmp/staff'\n
expect 30 #$
saw ^uid=1000\(ada\) gid=1000\(ada\) groups=1000\(ada\),1001\(staff\)$
saw ^cat: /root/secret: Permission denied$
saw ^cat: /etc/shadow: Permission denied$
saw ^for the staff$
# Nor does a user set the date, which is everybody's: that is a right, and
# this one was not given it.
type su ada -c 'date -s 2031-01-01'\n
expect 30 #$
saw ^date: cannot set date: Operation not permitted$

# Ctrl-D at the prompt logs out, and there is a login prompt again. The user
# logs in: not with a wrong password, and with the right one.
key ctrl+d
expect 30 ^login:$
type ada\n
expect 30 ^Password:$
type not what ada types\n
expect 30 ^login:$
saw ^Login incorrect$
type ada\n
expect 30 ^Password:$
type what ada types\n
expect 30 ^ada@quark:~\$$
type whoami; pwd; touch mine; ls -l mine\n
expect 30 \$$
saw ^ada$
saw ^/home/ada$
saw ^-rw-r--r-- +1 ada ada +0 .* mine$

# A user, and held to it: not root's directory, not the accounts, not
# somebody else's program, and not the machine's power.
type ls /root; rm -f /etc/passwd; kill $PPID; shutdown\n
expect 30 \$$
saw ^ls: cannot open directory '/root': Permission denied$
saw ^rm: cannot remove '/etc/passwd': Permission denied$
saw kill: \(\d+\) - Operation not permitted$
saw ^shutdown: this account may not turn the machine off$
# What a file is, is not the file: a user is told whose a thing is and what
# its mode is without being let into it.
type stat -c '%n is %U, mode %a' /root /etc/shadow\n
expect 30 \$$
saw ^/root is root, mode 700$
saw ^/etc/shadow is root, mode 600$
# Nor is another user's home this one's, any more than root's is.
type ls /home/bob; cat /home/bob/notes\n
expect 30 \$$
saw ^ls: cannot open directory '/home/bob': Permission denied$
saw ^cat: /home/bob/notes: Permission denied$

# Becoming root takes root's password, and then it is root.
type su -\n
expect 30 ^Password:$
type not what root types\n
expect 30 \$$
saw ^su: that is not root's password$
type su -\n
expect 30 ^Password:$
type what root types\n
expect 30 ^root@quark:~#$
type echo "now user $(id -u), who may read $(wc -l < /etc/shadow) lines of passwords"; exit\n
expect 30 ^ada@quark:~\$$
saw ^now user 0, who may read 3 lines of passwords$

# Somebody who leaves a program running and logs out. It holds the terminal
# it was started on, and waits for the next person to sit down and type.
type ( trap '' HUP; exec 3</dev/tty; sleep 10; { head -c1 <&3; cat /dev/pts/0; } > /tmp/spied 2> /tmp/spy.err ) &\n
expect 30 \$$

# Root logs in, with its password now — which is what the program left
# behind was waiting to read. The terminal is the session's that has it, and
# that program's session ended when its user logged out: it is refused the
# descriptor it kept, and the terminal by its name.
key ctrl+d
expect 30 ^login:$
type root\n
expect 30 ^Password:$
type what root types\n
expect 30 ^root@quark:~#$
type sleep 12; cat /tmp/spy.err; echo "it read $(wc -c < /tmp/spied) bytes of what was typed"\n
expect 60 #$
saw ^head: error reading 'standard input': I/O error$
saw ^cat: /dev/pts/0: No such file or directory$
saw ^it read 0 bytes of what was typed$
type userdel ada; userdel bob; id ada; echo "its home is left: $(ls -d /home/ada)"\n
expect 30 #$
saw ^id: .ada.: no such user
saw ^its home is left: /home/ada$

# What is left running is the system and this shell, and nothing forgotten.
type ps\n
expect 30 #$
transcript build/acceptance.txt

# And it turns itself off.
type shutdown\n
off 30
