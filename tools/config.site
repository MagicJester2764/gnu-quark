# What configure finds out by running a program, answered for Quark, for
# every package built with tools/recipe.sh.
#
# It cannot run a Quark program on the machine it is building on, so for
# each of these it takes a default — or, here and there, gives up. An answer
# belongs in this file when it is true of Quark whoever is asking; one that
# is about a single package is in that package's own config.site, which is
# read after this.

# gnulib asks whether strcasecmp agrees with tolower in a French ISO 8859-1
# locale, and has a guess for a cross build that it then does not use: it
# stops. musl has no such locale — every one it has is UTF-8 — so the test,
# run here, finds nothing to disagree about.
gl_cv_func_strcasecmp_works=yes

# Whether `getgroups` works — whether it says how many groups a process is
# in when asked with no room to write them — is found out by running a
# program. It does: a process is in the groups its account was put in, and
# says so. Left to guess, gnulib takes a system it has not heard of for one
# with no groups at all, and compiles in a `getgroups` of its own that only
# fails: `id` showed a user in one group whatever the kernel thought, while
# `cat` read a file that only one of the user's other groups could.
ac_cv_func_getgroups_works=yes
